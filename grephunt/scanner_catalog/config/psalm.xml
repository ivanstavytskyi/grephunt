<?xml version="1.0"?>
<psalm
    errorLevel="4"
    resolveFromConfigFile="false"
    findUnusedCode="false"
    findUnusedBaselineEntry="false"
    ensureOverrideAttribute="false"
>
    <projectFiles>
        <directory name="/src"/>
        <!-- allowMissingFiles: most projects have no vendor or node_modules; without it Psalm refuses the config. -->
        <ignoreFiles allowMissingFiles="true">
            <directory name="/src/vendor"/>
            <directory name="/src/node_modules"/>
        </ignoreFiles>
    </projectFiles>
</psalm>
