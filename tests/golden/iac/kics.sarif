						{
							"id": "67fd0c4a-68cf-46d7-8c41-bc9fba7e40ae",
							"name": "Last User Is 'root'",
							"shortDescription": {
								"text": "Last User Is 'root'"
							},
							"fullDescription": {
								"text": "Leaving the last user as root can cause security risks. Change to another user after running the commands that need privileges"
							},
							"defaultConfiguration": {
								"level": "error"
							},
							"helpUri": "https://docs.docker.com/engine/reference/builder/#user",
