							"shortDescription": {
								"text": "Privilege Escalation Allowed"
							},
							"fullDescription": {
								"text": "Containers should not run with allowPrivilegeEscalation in order to prevent them from gaining more privileges than their parent process"
							},
							"defaultConfiguration": {
								"level": "error"
